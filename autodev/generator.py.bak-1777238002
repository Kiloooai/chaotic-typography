def create_html_minigame(project_path, name):
    """Create an HTML/CSS/JS mini-game."""
    path = project_path / name
    path.mkdir(parents=True, exist_ok=True)

    (path / "index.html").write_text(f'''<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{name}</title>
    <style>
        body {{ margin: 0; padding: 0; background: #111; color: #fff; font-family: sans-serif; }}
        #game {{ width: 600px; height: 400px; border: 2px solid #333; margin: 50px auto; position: relative; overflow: hidden; }}
        #player {{ width: 20px; height: 20px; background: #0f0; position: absolute; border-radius: 50%; }}
        .enemy {{ width: 20px; height: 20px; background: #f00; position: absolute; border-radius: 50%; }}
        #score {{ position: absolute; top: 10px; left: 10px; font-size: 18px; }}
        #over {{ position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 24px; display: none; }}
    </style>
</head>
<body>
    <div id="game">
        <div id="player"></div>
        <div id="score">Score: 0</div>
        <div id="over">GAME OVER</div>
    </div>
    <script>
        const game = document.getElementById('game');
        const player = document.getElementById('player');
        const scoreEl = document.getElementById('score');
        const overEl = document.getElementById('over');
        let x = 290, y = 180, score = 0, running = true, keys = {{}};

        document.addEventListener('keydown', e => keys[e.key] = true);
        document.addEventListener('keyup', e => keys[e.key] = false);

        const enemies = [];
        function spawnEnemy() {{
            if (!running) return;
            const e = document.createElement('div');
            e.className = 'enemy';
            const ex = Math.random() * 580, ey = Math.random() * 380;
            e.style.left = ex + 'px'; e.style.top = ey + 'px';
            game.appendChild(e);
            enemies.push({{el: e, x: ex, y: ey}});
            setTimeout(spawnEnemy, 1000);
        }}
        spawnEnemy();

        function gameLoop() {{
            if (!running) return;
            if (keys['ArrowLeft']) x -= 5;
            if (keys['ArrowRight']) x += 5;
            if (keys['ArrowUp']) y -= 5;
            if (keys['ArrowDown']) y += 5;
            x = Math.max(0, Math.min(580, x));
            y = Math.max(0, Math.min(380, y));
            player.style.left = x + 'px'; player.style.top = y + 'px';

            for (let i = enemies.length - 1; i >= 0; i--) {{
                const en = enemies[i];
                en.x += (Math.random() - 0.5) * 8;
                en.y += (Math.random() - 0.5) * 8;
                en.el.style.left = en.x + 'px'; en.el.style.top = en.y + 'px';
                const dx = (x + 10) - (en.x + 10), dy = (y + 10) - (en.y + 10);
                if (Math.hypot(dx, dy) < 20) {{
                    running = false; overEl.style.display = 'block';
                }}
            }}
            scoreEl.textContent = 'Score: ' + Math.floor(score);
            score += 0.1;
            requestAnimationFrame(gameLoop);
        }}
        gameLoop();
    </script>
