#!/usr/bin/env python3
"""
Autonomous Project Generator — hourly cron runner
Generates small projects and pushes them to GitHub.
"""

import os
import sys
import json
import random
import subprocess
import datetime
from pathlib import Path

# === Config ===
WORKSPACE = Path("/root/.openclaw/workspace/autodev")
REPOS_DIR = WORKSPACE / "repos"
CURRENT_DIR = WORKSPACE / "current-project"
LOGS_DIR = WORKSPACE / "logs"
STATE_FILE = LOGS_DIR / "last-project-type.md"
COMPLETED_FILE = LOGS_DIR / "completed-projects.md"
ERROR_FILE = LOGS_DIR / "errors.md"

GITHUB_USERNAME = os.environ.get('GITHUB_USERNAME', 'kiloooai')
MAX_RETRIES = 2

# Project type rotation
PROJECT_TYPES = [
    "Python CLI utility",
    "HTML/CSS/JS single-page app",
    "Python mini-game",
    "HTML/CSS/JS mini-game",
    "Python automation script",
    "HTML/CSS/JS dashboard"
]

# === Helpers ===
def log(msg, print_to_stdout=True):
    timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{timestamp}] {msg}"
    if print_to_stdout:
        print(line)
    with open(ERROR_FILE, "a") as f:
        f.write(line + "\n")

def run_cmd(cmd, cwd=None, capture=False, retry_on_error=True):
    """Run a shell command with error handling."""
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            if capture:
                result = subprocess.run(cmd, shell=True, cwd=cwd, capture_output=True, text=True)
                if result.returncode == 0:
                    return result.stdout.strip()
                else:
                    if attempt == MAX_RETRIES:
                        raise RuntimeError(f"Command failed: {cmd}\n{result.stderr}")
            else:
                result = subprocess.run(cmd, shell=True, cwd=cwd)
                if result.returncode == 0:
                    return None
                else:
                    if attempt == MAX_RETRIES:
                        raise RuntimeError(f"Command failed with code {result.returncode}: {cmd}")
        except Exception as e:
            if attempt == MAX_RETRIES:
                raise
    return None

def get_next_project_type():
    """Read last used type and return next in rotation."""
    last = STATE_FILE.read_text().strip()
    try:
        last_idx = int(last)
    except ValueError:
        last_idx = -1
    next_idx = (last_idx + 1) % len(PROJECT_TYPES)
    return next_idx, PROJECT_TYPES[next_idx]

def generate_project_name(type_name):
    """Generate a random project name based on type."""
    prefixes = {
        "Python CLI utility": ["cli-", "tool-", "cmd-"],
        "HTML/CSS/JS single-page app": ["spark-", "pixel-", "view-"],
        "Python mini-game": ["game-", "puzzle-", "fun-"],
        "HTML/CSS/JS mini-game": ["play-", "arcade-", "tiny-"],
        "Python automation script": ["auto-", "bot-", "helper-"],
        "HTML/CSS/JS dashboard": ["dash-", "panel-", "stats-"]
    }
    nouns = ["alpha", "beta", "nova", "flux", "pulse", "wave", "core", "node", "grid", "loop"]
    prefix = random.choice(prefixes.get(type_name, ["proj-"]))
    noun = random.choice(nouns)
    num = random.randint(10, 999)
    return f"{prefix}{noun}-{num}"

def create_python_cli_utility(project_path, name):
    """Create a simple Python CLI utility."""
    path = project_path / name
    path.mkdir(parents=True, exist_ok=True)

    (path / f"{name}.py").write_text(f'''#!/usr/bin/env python3
"""
{name}: A simple command-line utility.
Example: python {name}.py --input file.txt --count 5
"""

import argparse
import sys

def main():
    parser = argparse.ArgumentParser(description="{name} - A utility")
    parser.add_argument("--input", "-i", help="Input file")
    parser.add_argument("--output", "-o", default="output.txt", help="Output file")
    parser.add_argument("--count", "-c", type=int, default=1, help="Number of times")
    parser.add_argument("--verbose", "-v", action="store_true", help="Verbose mode")
    args = parser.parse_args()

    if args.verbose:
        print(f"Processing {{args.input or 'stdin'}} → {{args.output}} (count={{args.count}})")

    with open(args.output, "w") as f:
        for i in range(args.count):
            f.write(f"Line {{i+1}}: Generated by {name}.\\n")

    print(f"Done. Wrote {{args.count}} lines to {{args.output}}")

if __name__ == "__main__":
    main()
''')

    (path / "requirements.txt").write_text("")
    (path / "README.md").write_text(f'''# {name}

A simple command-line utility.

## Install

```bash
python3 {name}.py --help
```

## Usage

```bash
python3 {name}.py --input data.txt --output result.txt --count 10 --verbose
```
''')

