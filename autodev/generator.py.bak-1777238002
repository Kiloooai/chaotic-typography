def create_python_automation_script(project_path, name):
    """Create a Python automation/utility script."""
    path = project_path / name
    path.mkdir(parents=True, exist_ok=True)

    (path / f"{name}.py").write_text(f'''#!/usr/bin/env python3
"""
{name}: Batch file organizer.
Moves files in a directory into subfolders by extension.
"""

import os
import shutil
import argparse
from pathlib import Path

def organize(src_dir, dry_run=False):
    src = Path(src_dir)
    if not src.exists():
        print(f"Directory does not exist: {{src}}")
        return

    moved = 0
    for item in src.iterdir():
        if item.is_file():
            ext = item.suffix.lower() or "no_extension"
            dest_dir = src / ext.lstrip(".")
            if not dest_dir.exists():
                if not dry_run:
                    dest_dir.mkdir()
            dest = dest_dir / item.name
            if not dest.exists():
                print(f"{{'[DRY] ' if dry_run else ''}}Moving {{item.name}} → {{ext}}/")
                if not dry_run:
                    shutil.move(str(item), str(dest))
                moved += 1
            else:
                print(f"Skip {{item.name}} (already exists in destination)")
    print(f"Done. Moved {{moved}} files.{{' (dry-run)' if dry_run else ''}}")

def main():
    parser = argparse.ArgumentParser(description="{name} — Organize files by extension")
    parser.add_argument("directory", nargs="?", default=".", help="Directory to organize")
    parser.add_argument("--dry-run", action="store_true", help="Preview without moving")
    args = parser.parse_args()
    organize(args.directory, args.dry_run)

if __name__ == "__main__":
    main()
''')

    (path / "requirements.txt").write_text("")
    (path / "README.md").write_text(f'''# {name}

A batch file organizer that sorts files into folders by extension.

## Usage

```bash
# Preview what would move
python3 {name}.py /path/to/folder --dry-run

# Actually organize
python3 {name}.py /path/to/folder
```
''')

