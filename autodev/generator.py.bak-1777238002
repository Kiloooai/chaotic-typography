def build_project(type_name, project_name):
    """Generate project files based on type."""
    PROJECT_BUILDERS = {
        "Python CLI utility": create_python_cli_utility,
        "HTML/CSS/JS single-page app": create_html_spa,
        "Python mini-game": create_python_minigame,
        "HTML/CSS/JS mini-game": create_html_minigame,
        "Python automation script": create_python_automation_script,
        "HTML/CSS/JS dashboard": create_html_dashboard,
    }
    builder = PROJECT_BUILDERS.get(type_name)
    if not builder:
        raise ValueError(f"Unknown project type: {type_name}")
    builder(REPOS_DIR, project_name)

# === Main workflow ===
def main():
    # Clean any previous run's current-project dir
    if CURRENT_DIR.exists():
        for f in CURRENT_DIR.iterdir():
            if f.is_file() or f.is_symlink():
                f.unlink()
            elif f.is_dir():
                shutil.rmtree(f)
    CURRENT_DIR.mkdir(parents=True, exist_ok=True)

    # Phase A: Plan
    type_idx, type_name = get_next_project_type()
    project_name = generate_project_name(type_name)
    plan = {
        "type_index": type_idx,
        "type_name": type_name,
        "project_name": project_name,
        "timestamp": datetime.datetime.now().isoformat()
    }
    (CURRENT_DIR / "plan.json").write_text(json.dumps(plan, indent=2))

    # Phase B: Code
    build_project(type_name, project_name)

    # Phase C: Push to GitHub
    project_dir = REPOS_DIR / project_name
    try:
        # Set git config for this project
        run_cmd('git init', cwd=project_dir)
        run_cmd('git config user.email "security.roblox@icloud.com"', cwd=project_dir)
        run_cmd('git config user.name "Kiloooai"', cwd=project_dir)
        run_cmd('git add .', cwd=project_dir)
        run_cmd('git commit -m "Initial commit: {project_name} — AutoDev autonomous build"', cwd=project_dir)

        # gh repo create
        run_cmd(f'gh repo create {project_name} --private --source=. --push', cwd=project_dir)

        # Verify
        last_commit = run_cmd('git log --oneline -1', cwd=project_dir, capture=True)
        log(f"✅ Pushed: {project_name} — {last_commit}")

        # Log completed
        with open(COMPLETED_FILE, "a") as f:
            f.write(f"[{datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] Type {type_idx}: {project_name} -> https://github.com/{GITHUB_USERNAME}/{project_name}\n")

        # Update state
        STATE_FILE.write_text(str(type_idx))

        # Phase D: Cleanup
        for f in CURRENT_DIR.iterdir():
            if f.is_file() or f.is_symlink():
                f.unlink()
            elif f.is_dir():
                shutil.rmtree(f)

        print(f"HEARTBEAT_OK | Project: {project_name} | Status: PUSHED | Repo: https://github.com/{GITHUB_USERNAME}/{project_name}")

    except Exception as e:
        log(f"❌ FAILED {project_name}: {str(e)}")
        print(f"HEARTBEAT_OK | Status: ERROR | {str(e)[:100]}")

if __name__ == "__main__":
    import shutil
    main()
